{
  "alarmEmail": "you@gmail.com",
  "defaultForwardTo": "you@gmail.com",
  "domains": {
    "example.com": {
      "catchAll": "you@gmail.com",
      "routes": {
        "sales@example.com": "sales@gmail.com",
        "support@example.com": "support@gmail.com",
        "departed@example.com": "bounce",
        "harvested@example.com": "drop"
      }
    },
    "another-domain.com": {
      "catchAll": "you@gmail.com"
    }
  },
  "blockSenders": {
    "spammer@junk-domain.example": "spam",
    "junk-domain.example": "spam",
    "*.skin": "drop"
  },
  "blockIps": {
    "203.0.113.0/24": "spam",
    "203.0.113.7": "drop"
  }
}
